{
  "name": "katecms",
  "version": "1.0.0-beta.4",
  "description": "Nuxt module that adds KateCMS to your application.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "vue",
    "cms",
    "admin",
    "content",
    "collections",
    "media"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/katecms/katecms.git",
    "directory": "packages/katecms"
  },
  "bugs": {
    "url": "https://github.com/katecms/katecms/issues"
  },
  "homepage": "https://github.com/katecms/katecms#readme",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./extensions": "./src/runtime/composables/useKateCmsExtensions.ts",
    "./server": "./src/runtime/server/kit.ts",
    "./styles": "./src/runtime/assets/styles/_index.scss"
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit",
    "test:basic": "vitest run test/basic.test.ts"
  },
  "dependencies": {
    "@katecms/core": "workspace:^",
    "@nuxt/kit": "^4.5.2",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2",
    "c12": "4.0.0-beta.5",
    "leaflet": "^1.9.4",
    "leaflet-control-geocoder": "^4.0.0",
    "leaflet.locatecontrol": "^0.90.0",
    "magic-string": "^1.1.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.4.1",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.1.0",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.locatecontrol": "^0.85.1",
    "@types/node": "latest",
    "nuxt": "^4.5.2",
    "sass-embedded": "^1.100.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  }
}
