{
  "name": "@miraicms/core",
  "version": "1.0.0",
  "description": "Framework-agnostic MiraiCMS core: config, database, auth, fields, media.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ldu1991/miraicms.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ldu1991/miraicms/issues"
  },
  "homepage": "https://github.com/ldu1991/miraicms#readme",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "browser": "./dist/browser.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "unbuild",
    "prepack": "unbuild",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "kysely": "^0.29.4",
    "pg": "^8.23.0",
    "better-sqlite3": "^13.0.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.21.0",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.11"
  }
}
