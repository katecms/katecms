{
  "packages": [
    {
      "name": "@miraicms/core",
      "dir": "packages/core",
      "sum": "Framework-agnostic MiraiCMS core: config, database, auth, fields, media.",
      "entries": [
        {
          "id": "core",
          "p": "packages/core/src/index.ts"
        },
        {
          "id": "core/browser",
          "p": "packages/core/src/browser.ts",
          "client": true
        }
      ],
      "deps": [
        "better-sqlite3",
        "kysely",
        "pg",
        "sharp"
      ],
      "dev": [
        "@types/node",
        "@types/pg",
        "typescript",
        "unbuild",
        "vitest"
      ],
      "scripts": [
        "build",
        "prepack",
        "test",
        "test:watch",
        "typecheck"
      ]
    },
    {
      "name": "basic",
      "dir": "packages/miraicms-nuxt/test/fixtures/basic"
    },
    {
      "name": "miraicms-monorepo",
      "dir": ".",
      "sum": "MiraiCMS monorepo: framework-agnostic core and Nuxt adapter.",
      "dev": [
        "@nuxt/eslint-config",
        "changelogen",
        "eslint",
        "npm-check-updates",
        "typescript"
      ],
      "scripts": [
        "ai:index",
        "check-updates",
        "dev",
        "dev:build",
        "dev:prepare",
        "lint",
        "prepack",
        "release",
        "test",
        "test:basic",
        "test:types",
        "test:watch",
        "upgrade-deps"
      ]
    },
    {
      "name": "miraicms-nuxt",
      "dir": "packages/miraicms-nuxt",
      "sum": "Nuxt module that adds MiraiCMS to your application.",
      "entries": [
        {
          "id": "nuxt",
          "p": "packages/miraicms-nuxt/src/module.ts"
        },
        {
          "id": "nuxt/extensions",
          "p": "packages/miraicms-nuxt/src/runtime/composables/useMiraiCmsExtensions.ts"
        },
        {
          "id": "nuxt/server",
          "p": "packages/miraicms-nuxt/src/runtime/server/kit.ts"
        },
        {
          "id": "nuxt/styles",
          "p": "packages/miraicms-nuxt/src/runtime/assets/styles/_index.scss"
        }
      ],
      "deps": [
        "@miraicms/core",
        "@nuxt/kit",
        "@tiptap/core",
        "@tiptap/extension-subscript",
        "@tiptap/extension-superscript",
        "@tiptap/extension-table",
        "@tiptap/extension-text-align",
        "@tiptap/extension-text-style",
        "@tiptap/pm",
        "@tiptap/starter-kit",
        "@tiptap/vue-3",
        "c12",
        "leaflet",
        "leaflet-control-geocoder",
        "leaflet.locatecontrol",
        "magic-string"
      ],
      "dev": [
        "@nuxt/devtools",
        "@nuxt/module-builder",
        "@nuxt/schema",
        "@nuxt/test-utils",
        "@types/leaflet",
        "@types/leaflet.locatecontrol",
        "@types/node",
        "nuxt",
        "sass-embedded",
        "typescript",
        "vitest",
        "vue",
        "vue-tsc"
      ],
      "workspace": [
        "@miraicms/core"
      ],
      "scripts": [
        "dev:prepare",
        "prepack",
        "test",
        "test:basic",
        "test:types",
        "test:watch"
      ]
    },
    {
      "name": "miraicms-nuxt-form",
      "dir": "packages/miraicms-nuxt-form",
      "sum": "Form builder addon for the MiraiCMS Nuxt module.",
      "entries": [
        {
          "id": "nuxt-form",
          "p": "packages/miraicms-nuxt-form/src/module.ts"
        }
      ],
      "deps": [
        "@miraicms/core",
        "@nuxt/kit",
        "kysely",
        "miraicms-nuxt",
        "nodemailer"
      ],
      "dev": [
        "@nuxt/module-builder",
        "@types/node",
        "nuxt",
        "sass-embedded",
        "typescript",
        "vue"
      ],
      "workspace": [
        "@miraicms/core",
        "miraicms-nuxt"
      ],
      "scripts": [
        "dev:prepare",
        "test"
      ]
    },
    {
      "name": "miraicms-nuxt-seo",
      "dir": "packages/miraicms-nuxt-seo",
      "sum": "SEO addon for the MiraiCMS Nuxt module: titles, sitemap, and robots.txt.",
      "entries": [
        {
          "id": "nuxt-seo",
          "p": "packages/miraicms-nuxt-seo/src/module.ts"
        }
      ],
      "deps": [
        "@miraicms/core",
        "@nuxt/kit",
        "kysely",
        "miraicms-nuxt"
      ],
      "dev": [
        "@nuxt/module-builder",
        "nuxt",
        "typescript",
        "vue"
      ],
      "workspace": [
        "@miraicms/core",
        "miraicms-nuxt"
      ],
      "scripts": [
        "dev:prepare"
      ]
    },
    {
      "name": "miraicms-playground-nuxt",
      "dir": "playground-nuxt",
      "deps": [
        "miraicms-nuxt",
        "miraicms-nuxt-form",
        "miraicms-nuxt-seo",
        "nuxt"
      ],
      "workspace": [
        "miraicms-nuxt",
        "miraicms-nuxt-form",
        "miraicms-nuxt-seo"
      ],
      "scripts": [
        "build",
        "dev",
        "generate",
        "seed"
      ]
    }
  ],
