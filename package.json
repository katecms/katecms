{
  "name": "katecms-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "KateCMS monorepo: framework-agnostic core and Nuxt adapter.",
  "repository": {
    "type": "git",
    "url": "https://github.com/katecms/katecms.git"
  },
  "bugs": {
    "url": "https://github.com/katecms/katecms/issues"
  },
  "homepage": "https://github.com/katecms/katecms#readme",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm run dev:prepare && pnpm --filter katecms-playground dev",
    "dev:build": "pnpm --filter katecms-playground build",
    "dev:prepare": "pnpm --filter @katecms/core build && pnpm --filter katecms dev:prepare && pnpm --filter katecms-form --filter katecms-seo dev:prepare && pnpm --filter katecms-playground exec nuxt prepare",
    "prepack": "pnpm --filter @katecms/core build && pnpm --filter katecms prepack",
    "publish:core": "pnpm --filter @katecms/core publish",
    "publish:module": "pnpm --filter katecms publish",
    "publish:form": "pnpm --filter katecms-form publish",
    "publish:seo": "pnpm --filter katecms-seo publish",
    "lint": "eslint .",
    "test": "pnpm --filter @katecms/core test && pnpm --filter @katecms/core build && pnpm --filter katecms test",
    "test:watch": "pnpm --filter @katecms/core test:watch",
    "test:types": "pnpm --filter @katecms/core typecheck && pnpm --filter katecms test:types",
    "test:basic": "pnpm --filter katecms test:basic",
    "ai:index": "node scripts/ai-index.mjs",
    "check-updates": "ncu --target minor",
    "upgrade-deps": "ncu --target minor -u && pnpm install"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.11.0",
    "npm-check-updates": "^23.1.0",
    "typescript": "^5.9.3"
  }
}
