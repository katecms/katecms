  "tables": [
    {
      "n": "users",
      "cols": "id:number*,email:string,password_hash:string,name:string?,avatar:json?,role:string*,status:UserStatus*,created_at:ts,updated_at:ts"
    },
    {
      "n": "collections",
      "cols": "id:number*,type:string,status:CollectionStatus*,slug:string,title:string,fields:json,blocks:json,author_id:number?,parent_id:number?,menu_order:number*,password_hash:string?,created_at:ts,updated_at:ts,published_at:ts?"
    },
    {
      "n": "collection_meta",
      "cols": "collection_id:number,key:string,value:json?"
    },
    {
      "n": "collection_revisions",
      "cols": "id:number*,collection_id:number,author_id:number?,data:json,created_at:ts"
    },
    {
      "n": "media",
      "cols": "id:number*,filename:string,mime_type:string,filesize:number,width:number?,height:number?,alt:string?,caption:string?,uploaded_by:number?,variants:json,variants_status:MediaVariantsStatus*,created_at:ts,updated_at:ts"
    },
    {
      "n": "dictionaries",
      "cols": "id:number*,slug:string,title:string,type:string,fields:json,parent_id:number?,created_at:ts,updated_at:ts"
    },
    {
      "n": "collection_dictionaries",
      "cols": "collection_id:number,dictionary_id:number"
    },
    {
      "n": "options",
      "cols": "key:string,value:json?"
    },
    {
      "n": "_miraicms_migrations",
      "cols": "id:string,applied_at:ts"
    },
    {
      "n": "miraicms_forms",
      "cols": "id,name,status,content,created_at,updated_at"
    },
    {
      "n": "miraicms_form_submissions",
      "cols": "id,form_id,ip,created_at"
    },
    {
      "n": "miraicms_form_submission_values",
      "cols": "id,submission_id,field_key,value"
    },
    {
      "n": "miraicms_form_mail",
      "cols": "id,host,port,encryption,username,password,from_email,from_name"
    },
    {
      "n": "seo_documents",
      "cols": "id,kind,entry_id,title,description,canonical,noindex,nofollow,site_name,title_separator,title_template,image,updated_at"
    },
    {
      "n": "seo_redirects",
      "cols": "id,from_path,to_path,status_code"
