{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "exclude": [
    "dist",
    "node_modules",
    "playground-nuxt",
    "playground-next",
    "packages/*/dist",
    "packages/*/.nuxt",
    "packages/miraicms-seo",
    "packages/miraicms-form"
  ]
}
